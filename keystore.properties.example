# Copy to keystore.properties (gitignored) to sign release builds.
# Paths are relative to the project root. Alternatively set the environment variables
# ZEN_KEYSTORE_FILE, ZEN_KEYSTORE_PASSWORD, ZEN_KEY_ALIAS and ZEN_KEY_PASSWORD.
storeFile=../keys/zen-mower-release.jks
storePassword=change-me
keyAlias=zenmower
keyPassword=change-me
