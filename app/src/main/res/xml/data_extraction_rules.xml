<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Game progress lives in WebView localStorage / IndexedDB under
    <data dir>/app_webview/, so back that up together with shared preferences.
    The GPU shader cache is device specific and is excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="root" path="app_webview/" />
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="root" path="app_webview/" />
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
    </device-transfer>
</data-extraction-rules>
